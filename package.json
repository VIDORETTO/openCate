{
  "name": "cate",
  "version": "1.6.1-beta.2",
  "productName": "Cate",
  "desktopName": "Cate",
  "description": "An infinite zoomable canvas IDE",
  "license": "MIT",
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "https://github.com/0-AI-UG/cate.git"
  },
  "homepage": "https://github.com/0-AI-UG/cate",
  "bugs": {
    "url": "https://github.com/0-AI-UG/cate/issues"
  },
  "author": {
    "name": "0-AI UG",
    "email": "hello@0-ai.org"
  },
  "main": "dist/main/index.js",
  "exports": {
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "default": "./dist/sdk/index.js"
    }
  },
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "postinstall": "node scripts/patch-electron-name.mjs",
    "predev": "node scripts/patch-electron-name.mjs",
    "setup": "bun install && bun run runtime:tarball",
    "dev": "electron-vite dev",
    "dev:dialog": "node scripts/run-command-with-env.mjs DEV_FORCE_DIALOG=1 electron-vite dev",
    "dev:firststart": "node scripts/run-command-with-env.mjs CATE_FRESH_USERDATA=1 electron-vite dev",
    "dev:update": "node scripts/dev-update.mjs",
    "test:update:fixture": "node scripts/verify-dev-update-fixture.mjs",
    "dev:update:major": "node scripts/run-command-with-env.mjs CATE_SIMULATE_UPDATE=major electron-vite dev",
    "dev:update:minor": "node scripts/run-command-with-env.mjs CATE_SIMULATE_UPDATE=minor electron-vite dev",
    "dev:update:patch": "node scripts/run-command-with-env.mjs CATE_SIMULATE_UPDATE=patch electron-vite dev",
    "sentry:test": "node scripts/sentry-test.mjs",
    "build": "electron-vite build",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:companion": "vite build --config companion-web/vite.config.mjs",
    "package:companion": "node scripts/package-companion.mjs",
    "test:companion:web": "node scripts/verify-companion-web.mjs",
    "test:companion:proxy": "node scripts/run-command-with-env.mjs CATE_COMPANION_PROXY=1 vitest --config vitest.live.config.ts relayProxy",
    "test:container:runtime": "node scripts/verify-container-runtime.mjs",
    "test:container:runtime:podman": "node scripts/run-command-with-env.mjs CATE_CONTAINER_ENGINE=podman node scripts/verify-container-runtime.mjs",
    "test:tmux:live": "node scripts/verify-tmux-live.mjs",
    "build:runtime": "node src/runtime/build/esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
   "verify:hygiene": "node scripts/verify-hygiene.mjs",
   "verify:companion-deployment": "node scripts/verify-companion-deployment.mjs",
    "verify:release-workflow": "node scripts/verify-release-workflow.mjs",
   "verify:repository-boundaries": "node scripts/verify-repository-boundaries.mjs",
    "test:ssh:loopback": "node scripts/run-command-with-env.mjs CATE_LOCAL_SSH_E2E=1 vitest --config vitest.live.config.ts sshLoopback",
    "test:agent-contracts": "node scripts/run-command-with-env.mjs CATE_LIVE_AGENT_CLIS=1 vitest --config vitest.live.config.ts agentHookContracts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/run-command-with-env.mjs E2E_SKIP_PERF=1 playwright test",
    "companion:relay": "bun src/main/companion/relayServerCli.ts",
    "test:smoke:electron": "node scripts/run-electron-smoke.mjs",
    "test:smoke:telemetry": "node scripts/verify-packaged-telemetry.mjs",
    "test:smoke:packaged-restore": "node scripts/verify-packaged-restore.mjs",
    "verify:release-metadata": "node scripts/verify-release-metadata.mjs",
    "icons": "node scripts/generate-icons.js",
    "runtime:tarball": "node scripts/build-runtime-tarball.mjs",
    "pi:tarball": "node scripts/build-pi-tarball.mjs",
    "package": "node scripts/package.mjs",
    "package:mac": "node scripts/package.mjs --mac",
    "package:win": "node scripts/package.mjs --win",
    "package:linux": "node scripts/package.mjs --linux"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "node-pty",
      "sharp",
      "esbuild"
    ]
  },
  "trustedDependencies": [
    "@google/genai",
    "agent-browser",
    "electron",
    "esbuild",
    "koffi",
    "node-pty",
    "protobufjs",
    "sharp"
  ],
  "overrides": {
    "node-gyp": "^12.4.0",
    "@xmldom/xmldom": "0.8.15"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "@parcel/watcher": "^2.5.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/electron": "^7.15.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "agent-browser": "0.33.0",
    "chokidar": "^4.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "mammoth": "^1.12.0",
    "monaco-editor": "^0.52.0",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.27.0",
    "use-sync-external-store": "^1.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.60.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vscode/ripgrep": "^1.18.0",
    "autoprefixer": "^10.4.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "node-pty": "^1.0.0",
    "playwright": "^1.60.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.2.4"
  }
}
