# Copy to /etc/cate/companion-relay.env and set mode 0640.
# Keep this file readable only by root and the cate-relay service group.
# The relay must stay loopback-only; Caddy is the public TLS boundary.
CATE_RELAY_HOST=127.0.0.1
CATE_RELAY_PORT=8787
CATE_RELAY_CORS_ORIGIN=https://companion.example.com
