#!/bin/sh
# POSIX launcher for the `opencate` CLI. Resolves the bundled Node and the
# CLI relative to this shim's own location, so `opencate` works without node on PATH.
# Staged layout: <install>/opencate/bin/opencate, <install>/opencate/dist/cli.cjs,
#                <install>/runtime/bin/node
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$here/../../runtime/bin/node" "$here/../dist/cli.cjs" "$@"
